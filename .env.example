# OpenRouter key for Jev's TypeSafe-compatible endpoint.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_MODEL=typesafe/jev-1.13
# Direct TypeSafe alternative: TYPESAFE_BASE_URL=https://api.typesafe.ai,
# TYPESAFE_MODEL=jev-1.13.0, and a TypeSafe-issued TYPESAFE_API_KEY.
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
TEXT_MODEL_RESPONSE_FORMAT=json_schema
